# Copy this file to .env for local development, or set these as real
# environment variables in Render's dashboard for production.
# See Deployment Plan §2 in shiftfloor_project_plan.md for details.

# --- Django core ---
SECRET_KEY=change-me-to-a-random-secret-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (leave unset locally to use SQLite automatically) ---
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Cloudinary (media storage — required in production, optional locally) ---
CLOUDINARY_URL=

# --- Email (Anymail + Brevo free tier) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
ANYMAIL_BREVO_API_KEY=
DEFAULT_FROM_EMAIL=no-reply@shiftfloor.example.com

# --- Stripe (test mode keys — never use live keys in this demo deployment) ---
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# --- Site meta ---
SITE_DOMAIN=localhost:8000

# --- Render (auto-set by Render in production, leave blank locally) ---
# RENDER_EXTERNAL_HOSTNAME=
