# Copy this file to .env for local development, or set these as real
# environment variables in Render's dashboard for production.
# See Deployment Plan §2 in shiftfloor_project_plan.md for details.

# --- Django core ---
SECRET_KEY=change-me-to-a-random-secret-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# SQLite everywhere (local and production) — leave DATABASE_URL unset.
# It parses a Postgres-style DATABASE_URL too if you ever need it, but
# this project's Render deploy intentionally does not set one.

# --- Internal scheduled-task endpoints (see .github/workflows/scheduled_tasks.yml) ---
# Shared secret checked by core_app.views.task_expire_shifts /
# task_send_shift_reminders. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_TASK_KEY=

# --- Cloudinary (media storage — required in production, optional locally) ---
CLOUDINARY_URL=

# --- Email (Anymail + Brevo free tier) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
ANYMAIL_BREVO_API_KEY=
DEFAULT_FROM_EMAIL=no-reply@shiftfloor.example.com

# --- Stripe (test mode keys — never use live keys in this demo deployment) ---
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# --- Site meta ---
SITE_DOMAIN=localhost:8000

# --- Render (auto-set by Render in production, leave blank locally) ---
# RENDER_EXTERNAL_HOSTNAME=
